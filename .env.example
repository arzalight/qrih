NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# El callback de confirmación se construye desde el dominio abierto en el navegador:
# <origen-actual>/auth/callback. Agrega los dominios local, staging y producción
# correspondientes en Supabase Auth > URL Configuration > Redirect URLs.

# Sólo servidor (Netlify runtime), nunca NEXT_PUBLIC_ ni commit con valor real.
SUPABASE_SERVICE_ROLE_KEY=

# Netlify Functions proporciona SITE_ID y URL automáticamente (sólo lectura).
# El servidor valida Origin contra URL canónica; no añadir aliases/previews.
# En desarrollo local conserva la comparación contra el origen del request.
